# ============================================================
# TasteCraft — Environment Configuration
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.example .env

# ============================================================
# Required API Keys
# ============================================================

# Anthropic (Claude) — primary AI model
ANTHROPIC_API_KEY=sk-ant-xxx

# TikHub — competitor monitoring + data collection
TIKHUB_API_KEY=xxx

# Secret key for JWT / session signing (generate a random string for prod)
SECRET_KEY=change-this-to-random-string

# ============================================================
# Database
# ============================================================

# SQLite (development — no extra setup needed)
DATABASE_URL=sqlite+aiosqlite:///./data/tastecraft_dev.db

# PostgreSQL (production / Docker Compose)
# DATABASE_URL=postgresql+asyncpg://tastecraft:tastecraft_dev@localhost:5432/tastecraft

# Docker Compose postgres password (default: tastecraft_dev)
POSTGRES_PASSWORD=tastecraft_dev

# ============================================================
# Redis (optional for dev, required for Celery in production)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Application Settings
# ============================================================
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Server (local dev)
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================
# Platform Credentials (optional)
# ============================================================

# WeChat Official Account
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# OpenAI (fallback / embeddings)
OPENAI_API_KEY=

# ============================================================
# CORS & Security
# ============================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ============================================================
# Platform Cookies (for browser automation publishing)
# ============================================================
XHS_COOKIE=
WEIBO_COOKIE=
ZHIHU_COOKIE=
DOUYIN_COOKIE=
BILIBILI_COOKIE=
